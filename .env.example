# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ALLOW_DEV_TOKEN: Development-only authentication bypass toggle (server-side).
# Defaults to false. When set to 'true' in non-production, accepts dev-token-* credentials.
# STRICTLY FORBIDDEN and automatically rejected when NODE_ENV=production.
ALLOW_DEV_TOKEN="false"

# VITE_ALLOW_DEV_TOKEN: Frontend developer token toggle.
# Defaults to false. When 'true' in dev mode, allows generating dev-token-creator-default.
VITE_ALLOW_DEV_TOKEN="false"

# TRUST_PROXY: Reverse proxy trust configuration for Express IP rate-limiting.
# Configure as '1' or true behind a single reverse proxy (e.g. Google Cloud Run).
# Defaults to false (only trusting direct TCP socket address) to prevent X-Forwarded-For spoofing.
TRUST_PROXY="false"

# FIREBASE_PROJECT_ID: Cloud Firestore & Firebase Auth project identifier.
# Automatically read from firebase-applet-config.json if present.
FIREBASE_PROJECT_ID=""
